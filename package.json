{
  "name": "shmakk-desktop",
  "version": "0.1.0",
  "description": "shmakk AI coding assistant — desktop client",
  "author": "Marcus Bader <marcus.e.r.bader@gmail.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "electron:build": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "remark-gfm": "^4.0.1",
    "shmakk": "^1.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.shmakk.desktop",
    "productName": "shmakk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "executableName": "shmakk-desktop",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Marcus Bader <marcus.e.r.bader@gmail.com>",
      "category": "Development",
      "artifactName": "shmakk-${version}-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "build/deb/after-install.sh",
      "afterRemove": "build/deb/after-remove.sh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
